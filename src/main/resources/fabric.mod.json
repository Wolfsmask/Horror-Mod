{
  "schemaVersion": 1,
  "id": "occupant",
  "version": "${version}",
  "name": "The Occupant",
  "description": "A psychological horror mod. Something else is living in your world, and it is learning how to be you.",
  "authors": [
    "Wolfsmask"
  ],
  "contact": {
    "sources": "https://github.com/Wolfsmask/Horror-Mod"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.wolfsmask.occupant.Occupant"
    ],
    "client": [
      "com.wolfsmask.occupant.client.OccupantClient"
    ],
    "fabric-gametest": [
      "com.wolfsmask.occupant.test.OccupantGameTests",
      "com.wolfsmask.occupant.test.ArenaGameTests"
    ],
    "fabric-client-gametest": [
      "com.wolfsmask.occupant.client.test.OccupantClientGameTest"
    ]
  },
  "mixins": [
    {
      "config": "occupant.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft_dep}",
    "java": "${java_dep}",
    "fabric-api": "*"
  },
  "icon": "assets/occupant/icon.png"
}
